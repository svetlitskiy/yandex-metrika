{
  "name": "@svetlitskiy/yandex-metrika",
  "version": "0.1.0",
  "description": "Framework-neutral Yandex Metrica SDK for browser goals and server-side Measurement Protocol events",
  "keywords": [
    "analytics",
    "measurement-protocol",
    "metrica",
    "typescript",
    "yandex",
    "yandex-metrica"
  ],
  "license": "MIT",
  "author": "Aleksey Svetlitskiy",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18.18.0"
  },
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./browser": {
      "import": {
        "types": "./dist/browser/index.d.ts",
        "default": "./dist/browser/index.js"
      },
      "require": {
        "types": "./dist/browser/index.d.cts",
        "default": "./dist/browser/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server/index.d.ts",
        "default": "./dist/server/index.js"
      },
      "require": {
        "types": "./dist/server/index.d.cts",
        "default": "./dist/server/index.cjs"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types.d.ts",
        "default": "./dist/types.js"
      },
      "require": {
        "types": "./dist/types.d.cts",
        "default": "./dist/types.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build && npm run check:package",
    "check:package": "publint --pack=false && node scripts/check-package.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svetlitskiy/yandex-metrika.git"
  },
  "bugs": {
    "url": "https://github.com/svetlitskiy/yandex-metrika/issues"
  },
  "homepage": "https://github.com/svetlitskiy/yandex-metrika#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@types/node": "^22.15.0",
    "prettier": "^3.5.3",
    "publint": "^0.3.12",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
